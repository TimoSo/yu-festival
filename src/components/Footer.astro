---
import { site, nav, contact } from '../data/site';
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand-col">
      <div class="site-footer__logo">
        <Logo variant="stacked" width="150px" />
      </div>
      <p class="site-footer__subtitle">{site.subtitle} · {site.subtitleAlt}</p>
      <a class="site-footer__mail" href={`mailto:${contact.email}`}>
        {contact.email}
      </a>
    </div>

    <nav aria-label="Footer-Navigation">
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
  </div>

  <div class="container site-footer__meta">
    <span>© {year} {site.name}</span>
    <span>Eintritt frei</span>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--deep-purple);
    color: var(--white);
    padding-block: 3rem 1.5rem;
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem 3rem;
    align-items: start;
    justify-content: space-between;
  }

  .site-footer__logo {
    color: var(--white);
    line-height: 0;
    margin-bottom: 1rem;
  }
  .site-footer__subtitle {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--lime);
    margin: 0 0 0.6rem;
  }
  .site-footer__mail {
    font-weight: 900;
    color: var(--white);
  }

  .site-footer nav ul {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, auto);
    gap: 0.6rem 2.5rem;
    margin: 0;
    padding: 0;
  }
  .site-footer nav a {
    font-weight: 700;
    color: var(--white);
    text-decoration: none;
  }
  .site-footer nav a:hover {
    color: var(--lime);
  }

  .site-footer__meta {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 2px solid color-mix(in srgb, var(--white) 25%, transparent);
    font-weight: 700;
    font-size: 0.85rem;
  }
</style>
