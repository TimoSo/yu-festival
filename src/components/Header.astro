---
import { nav } from '../data/site';
import Logo from './Logo.astro';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="brand" aria-label="YU Festival – Startseite">
      <Logo variant="horizontal" width="200px" label="YU Festival" />
    </a>

    <button
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="primary-nav"
      aria-label="Menü öffnen"
    >
      <span></span><span></span><span></span>
    </button>

    <nav id="primary-nav" class="site-nav" aria-label="Hauptnavigation">
      <ul>
        {
          nav.map((item) => (
            <li class:list={['site-nav__item', { 'has-sub': !!item.children }]}>
              <a
                href={item.href}
                class:list={[
                  'site-nav__link',
                  { 'is-active': isActive(item.href) },
                ]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
                {item.children && <span class="caret" aria-hidden="true" />}
              </a>

              {item.children && (
                <ul class="subnav">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class:list={[
                          'subnav__link',
                          { 'is-active': path === child.href },
                        ]}
                        aria-current={path === child.href ? 'page' : undefined}
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--deep-purple);
    color: var(--white);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 0.9rem;
  }

  .brand {
    display: inline-flex;
    color: var(--white);
    flex-shrink: 0;
  }
  .brand:hover {
    color: var(--lime);
  }

  .site-nav ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.5rem;
    margin: 0;
    padding: 0;
    justify-content: flex-end;
  }

  .site-nav__item {
    position: relative;
  }

  .site-nav__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 700;
    font-size: 0.92rem;
    text-decoration: none;
    color: var(--white);
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius-pill);
    transition: background 0.15s ease, color 0.15s ease;
  }
  .site-nav__link:hover {
    background: var(--lavender);
    color: var(--white);
  }
  .site-nav__link.is-active {
    background: var(--lime);
    color: var(--deep-purple);
  }

  .caret {
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid currentColor;
    transition: transform 0.2s ease;
  }
  .has-sub:hover .caret,
  .has-sub:focus-within .caret {
    transform: rotate(180deg);
  }

  /* ---- Untermenü (Desktop: aufklappen bei Hover/Fokus) ---- */
  .subnav {
    position: absolute;
    top: calc(100% + 0.35rem);
    left: 0;
    min-width: 11rem;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.4rem;
    border-radius: var(--radius-sm);
    background: var(--lavender);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition:
      opacity 0.18s ease,
      transform 0.18s ease,
      visibility 0.18s;
  }
  .has-sub:hover .subnav,
  .has-sub:focus-within .subnav {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .subnav__link {
    display: block;
    padding: 0.5rem 0.8rem;
    border-radius: var(--radius-pill);
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--white);
    text-decoration: none;
    white-space: nowrap;
  }
  .subnav__link:hover {
    background: color-mix(in srgb, var(--white) 22%, transparent);
  }
  .subnav__link.is-active {
    background: var(--lime);
    color: var(--deep-purple);
  }

  /* ---- Mobiles Menü ---- */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    background: none;
    border: 0;
    cursor: pointer;
    padding: 0;
  }
  .nav-toggle span {
    display: block;
    height: 3px;
    width: 26px;
    border-radius: 999px;
    background: var(--white);
  }

  @media (max-width: 980px) {
    .nav-toggle {
      display: flex;
    }
    .site-nav {
      position: absolute;
      inset: 100% 0 auto 0;
      background: var(--deep-purple);
      display: none;
      padding-bottom: 0.75rem;
    }
    .site-nav.is-open {
      display: block;
    }
    .site-nav > ul {
      flex-direction: column;
      gap: 0.15rem;
      padding: 0.5rem clamp(1.25rem, 5vw, 2.5rem);
      justify-content: flex-start;
    }
    .site-nav__link {
      display: flex;
      font-size: 1.05rem;
      padding: 0.7rem 1rem;
    }
    .caret {
      display: none;
    }
    /* Untermenü ist mobil dauerhaft sichtbar, nur eingerückt */
    .subnav {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      box-shadow: none;
      background: none;
      display: flex;
      padding: 0 0 0.35rem 1rem;
    }
    .subnav__link {
      font-size: 0.98rem;
      padding: 0.5rem 1rem;
      opacity: 0.85;
    }
  }
</style>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const navMenu = document.getElementById('primary-nav');

  toggle?.addEventListener('click', () => {
    const open = navMenu?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(Boolean(open)));
    toggle.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen');
  });
</script>
