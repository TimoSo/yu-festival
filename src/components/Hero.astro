---
import { site, landing, contact } from '../data/site';
import IconInstagram from './IconInstagram.astro';
import Logo from './Logo.astro';
import Deco from './Deco.astro';
---

<!-- Hintergrund: Schnörkel-Muster aus dem Social-Media-Header, wie bei
     den Seitenköpfen der Unterseiten (.section--muster) -->
<section class="section section--muster hero">
  <div class="container hero__inner">
    <div class="hero__content">
      <p class="eyebrow">{site.subtitleAlt}</p>

      <div class="hero__logo">
        <Logo variant="stacked" width="min(300px, 64vw)" />
      </div>

      {/* <wbr> erlaubt saubere Umbruchstellen nach den Punkten */}
      <h1 class="hero__title">
        Medien<span class="dot">.</span><wbr />Kunst<span class="dot">.</span><wbr
        />Diskurs
      </h1>

      <p class="hero__facts">
        <span class="hero__pill">{site.date} · {site.location}</span>
        {site.free && <span class="hero__pill hero__pill--free">Eintritt frei</span>}
      </p>

      <p class="lead hero__lead">{landing.intro}</p>

      <div class="hero__actions">
        <a class="btn btn--primary" href="/programm">Zum Programm</a>
        <a class="btn btn--ghost" href="/about/festival">Über das Festival</a>
        <a class="btn btn--ghost" href={contact.instagram} target="_blank" rel="noopener noreferrer">
          <IconInstagram /> Instagram
        </a>
      </div>
    </div>

    <div class="hero__deco" aria-hidden="true">
      <div class="hero__capsule">
        <Deco shape="capsule" width="min(260px, 45vw)" />
      </div>
      <div class="hero__squiggle">
        <Deco shape="squiggle" width="min(320px, 60vw)" />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    overflow: hidden;
  }

  .hero__inner {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 1000px) {
    .hero__inner {
      grid-template-columns: 1fr auto;
    }
  }

  .hero__logo {
    color: var(--white);
    line-height: 0;
    margin-bottom: 1.75rem;
  }

  .hero__title {
    margin-bottom: 1.25rem;
  }
  .hero__title .dot {
    color: var(--lime);
  }

  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1.75rem;
  }
  .hero__pill {
    display: inline-block;
    padding: 0.45rem 1.1rem;
    border-radius: var(--radius-pill);
    background: var(--lavender);
    color: var(--white);
    font-weight: 900;
    font-size: 0.9rem;
    letter-spacing: 0.02em;
  }
  .hero__pill--free {
    background: var(--lime);
    color: var(--deep-purple);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .hero__lead {
    max-width: 58ch;
    margin-bottom: 2rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .hero__deco {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }
  .hero__capsule {
    color: var(--lime);
    --deco-inner: var(--lavender);
  }
  .hero__squiggle {
    color: var(--coral);
  }

  @media (max-width: 999px) {
    .hero__deco {
      flex-direction: row;
      justify-content: flex-start;
      align-items: center;
      flex-wrap: wrap;
    }
  }
</style>
