---
import { site, landing } from '../data/site';
import Deco from './Deco.astro';

// Titelbild = Social-Media-Header (Grafik: Jana Canê). Schmale Bildschirme
// bekommen die gestapelte Fassung (seitlich beschnitten, damit das Logo
// groß bleibt), ab 760 px die quere. Erzeugt aus den Originalen
// YU_Header.png / YU_Header2.png im selben Ordner.
const H = '/images/header/';
---

<div class="keyvisual">
  <picture>
    <source
      media="(min-width: 760px)"
      srcset={`${H}yu-header-quer-1280.webp 1280w, ${H}yu-header-quer-1920.webp 1920w, ${H}yu-header-quer-2560.webp 2560w`}
      sizes="100vw"
      width="2560"
      height="1254"
    />
    <img
      src={`${H}yu-header-gestapelt-800.webp`}
      srcset={`${H}yu-header-gestapelt-800.webp 800w, ${H}yu-header-gestapelt-1200.webp 1200w`}
      sizes="100vw"
      width="1200"
      height="784"
      alt="YU Festival"
      fetchpriority="high"
      decoding="async"
    />
  </picture>
</div>

<section class="section section--lavender hero">
  <div class="container hero__inner">
    <div class="hero__content">
      <p class="eyebrow">{site.subtitleAlt}</p>

      {/* <wbr> erlaubt saubere Umbruchstellen nach den Punkten */}
      <h1 class="hero__title">
        Medien<span class="dot">.</span><wbr />Kunst<span class="dot">.</span><wbr
        />Diskurs
      </h1>

      <p class="hero__facts">
        <span class="hero__pill">{site.date} · {site.location}</span>
        {site.free && <span class="hero__pill hero__pill--free">Eintritt frei</span>}
      </p>

      <p class="lead hero__lead">{landing.intro[0]}</p>
      <p class="hero__text">{landing.intro[1]}</p>

      <div class="hero__actions">
        <a class="btn btn--primary" href="/programm">Zum Programm</a>
        <a class="btn btn--ghost" href="/about/festival">Über das Festival</a>
      </div>
    </div>

    <div class="hero__deco" aria-hidden="true">
      <div class="hero__capsule">
        <Deco shape="capsule" width="min(260px, 45vw)" />
      </div>
      <div class="hero__squiggle">
        <Deco shape="squiggle" width="min(320px, 60vw)" />
      </div>
    </div>
  </div>
</section>

<style>
  .keyvisual {
    background: var(--deep-purple);
    line-height: 0;
  }
  .keyvisual img {
    width: 100%;
    height: auto;
  }
  /* Quere Fassung: Das Logo liegt zwischen 35 und 68 % der Bildhöhe.
     Oben und unten darf deshalb Muster wegfallen – so passt das Bild
     auch auf breiten, niedrigen Bildschirmen in den ersten Blick. */
  @media (min-width: 760px) {
    .keyvisual img {
      height: clamp(100vw / 4.2, 72vh, 100vw / 2.04);
      object-fit: cover;
    }
  }

  .hero {
    overflow: hidden;
  }

  .hero__inner {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 1000px) {
    .hero__inner {
      grid-template-columns: 1fr auto;
    }
  }

  .hero__title {
    margin-bottom: 1.25rem;
  }
  .hero__title .dot {
    color: var(--lime);
  }

  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1.75rem;
  }
  .hero__pill {
    display: inline-block;
    padding: 0.45rem 1.1rem;
    border-radius: var(--radius-pill);
    background: var(--deep-purple);
    color: var(--white);
    font-weight: 900;
    font-size: 0.9rem;
    letter-spacing: 0.02em;
  }
  .hero__pill--free {
    background: var(--lime);
    color: var(--deep-purple);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .hero__lead {
    max-width: 58ch;
    margin-bottom: 1rem;
  }
  .hero__text {
    max-width: 62ch;
    margin-bottom: 2rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .hero__deco {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }
  .hero__capsule {
    color: var(--lime);
    --deco-inner: var(--lavender);
  }
  .hero__squiggle {
    color: var(--coral);
  }

  @media (max-width: 999px) {
    .hero__deco {
      flex-direction: row;
      justify-content: flex-start;
      align-items: center;
      flex-wrap: wrap;
    }
  }
</style>
