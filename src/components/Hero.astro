---
import { site } from '../data/site';
import Logo from './Logo.astro';
import Deco from './Deco.astro';
---

<section class="section section--lavender hero">
  <div class="container hero__inner">
    <div class="hero__content">
      <p class="eyebrow">{site.subtitleAlt}</p>

      <div class="hero__logo">
        <Logo variant="stacked" width="min(340px, 70vw)" />
      </div>

      {/* <wbr> erlaubt saubere Umbruchstellen nach den Punkten */}
      <h1 class="hero__title">
        Medien<span class="dot">.</span><wbr />Kunst<span class="dot">.</span><wbr
        />Diskurs
      </h1>

      <p class="lead hero__lead">
        Ein Festival für digitale Medien – mit kritischem Blick, aber vor allem
        mit Gestaltungslust. Es geht um die Möglichkeiten, die das Individuum
        und das „Wir" als Kollektiv in die Hand nehmen.
      </p>

      <div class="hero__actions">
        <a class="btn btn--primary" href="/programm">Zum Programm</a>
        <a class="btn btn--ghost" href="/about">Über das Festival</a>
      </div>

      {site.free && <p class="hero__free">Eintritt frei</p>}
    </div>

    <div class="hero__deco" aria-hidden="true">
      <div class="hero__capsule">
        <Deco shape="capsule" width="min(260px, 45vw)" />
      </div>
      <div class="hero__squiggle">
        <Deco shape="squiggle" width="min(320px, 60vw)" />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    overflow: hidden;
  }

  .hero__inner {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 1000px) {
    .hero__inner {
      grid-template-columns: 1fr auto;
    }
  }

  .hero__logo {
    color: var(--white);
    line-height: 0;
    margin-bottom: 1.75rem;
  }

  .hero__title {
    margin-bottom: 1.25rem;
  }
  .hero__title .dot {
    color: var(--lime);
  }

  .hero__lead {
    margin-bottom: 2rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .hero__free {
    display: inline-block;
    margin-top: 1.75rem;
    padding: 0.5rem 1.25rem;
    border-radius: var(--radius-pill);
    background: var(--lime);
    color: var(--deep-purple);
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 0.9rem;
  }

  .hero__deco {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }
  .hero__capsule {
    color: var(--lime);
    --deco-inner: var(--lavender);
  }
  .hero__squiggle {
    color: var(--coral);
  }

  @media (max-width: 999px) {
    .hero__deco {
      flex-direction: row;
      justify-content: flex-start;
      align-items: center;
      flex-wrap: wrap;
    }
  }
</style>
