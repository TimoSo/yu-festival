---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { inhalt } from '../data/inhalt';
import { spracheVon, ui, pfad } from '../i18n';

const lang = spracheVon(Astro.url);
const t = ui(lang);
const { team, kooperation, specialThanks, seiten } = inhalt(lang);
---

<BaseLayout title={seiten.team.title} description={seiten.team.description}>
  <PageHeader eyebrow={seiten.team.eyebrow} title={seiten.team.title} lead={seiten.team.lead} />

  <section class="section">
    <div class="container">
      <ul class="team">
        {
          team.map((eintrag) => (
            <li class="team__item">
              <p class="team__role">{eintrag.role}</p>
              <p class="team__names">{eintrag.names}</p>
            </li>
          ))
        }
      </ul>

      <h2 class="danke__titel">{t.team.specialThanks}</h2>
      <ul class="danke">
        {specialThanks.map((name) => <li>{name}</li>)}
      </ul>
    </div>
  </section>

  <section class="section section--lime">
    <div class="container narrow">
      <h2>{t.team.kooperation}</h2>
      {kooperation.map((absatz) => <p>{absatz}</p>)}
      <p style="margin-top: 2rem;">
        <a class="btn btn--primary" href={pfad(lang, 'partner')}>{t.team.zuDenPartnern}</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .team {
    list-style: none;
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 640px) {
    .team {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 980px) {
    .team {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .team__item {
    border: var(--border-w) solid var(--lavender);
    border-radius: var(--radius);
    padding: 1.25rem 1.5rem;
  }
  .team__role {
    font-weight: 900;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--lavender);
    margin: 0 0 0.4rem;
    line-height: 1.35;
  }
  .team__names {
    font-weight: 900;
    font-size: 1.15rem;
    margin: 0;
    line-height: 1.3;
  }

  /* Special Thanks: Namen als Pillen im Fluss */
  .danke__titel {
    margin-top: clamp(3rem, 7vw, 4.5rem);
    color: var(--deep-purple);
  }
  .danke {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.5rem 0 0;
    padding: 0;
  }
  .danke li {
    font-weight: 900;
    padding: 0.45rem 1rem;
    border: 3px solid var(--lavender);
    border-radius: var(--radius-pill);
    color: var(--deep-purple);
  }
</style>
