---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import RichText from '../components/RichText.astro';
import { impressum, haftungsausschluss, type RechtsAbschnitt } from '../data/impressum';
import { spotlight } from '../data/site';

const v = impressum.verantwortlich;

// Bildnachweise sammeln sich aus den Daten (Kurzvorstellung)
const bildnachweise = spotlight
  .filter((p) => p.fotoCredit)
  .map((p) => `Porträt ${p.name}: ${p.fotoCredit}`);
---

<BaseLayout
  title="Impressum"
  description="Impressum, Haftungsausschluss und Datenschutzhinweise des YU Festivals."
>
  <PageHeader
    eyebrow="Rechtliches"
    title="Impressum"
    lead="Anbieterkennzeichnung, Haftungsausschluss und Datenschutz."
  />

  <section class="section">
    <div class="container narrow recht">
      <p class="recht__intro">{impressum.intro}</p>

      <h2>{v.titel}</h2>
      <p>
        {v.anschrift.map((zeile) => (
          <>
            {zeile}
            <br />
          </>
        ))}
      </p>
      <p>
        E-Mail: <a href={`mailto:${v.email}`}>{v.email}</a>
        <br />
        Telefon: <a href={`tel:${v.telefonLink}`}>{v.telefon}</a>
      </p>

      <h2>Haftungsausschluss</h2>
      {
        haftungsausschluss.map((a: RechtsAbschnitt) => (
          <section class="recht__abschnitt">
            <h3>{a.titel}</h3>
            <RichText paras={a.absaetze} />
            {a.liste && (
              <ul>
                {a.liste.map((punkt) => (
                  <li>
                    <strong>{punkt.fett}</strong> {punkt.text}
                  </li>
                ))}
              </ul>
            )}
            {a.nach && <RichText paras={a.nach} />}
            {a.unter?.map((u) => (
              <>
                <h4>{u.titel}</h4>
                <RichText paras={u.absaetze} />
              </>
            ))}
          </section>
        ))
      }

      {
        bildnachweise.length > 0 && (
          <>
            <h2>Bildnachweise</h2>
            <ul>
              {bildnachweise.map((zeile) => (
                <li>{zeile}</li>
              ))}
            </ul>
          </>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  /* Rechtstext: ruhige Gliederung in Helvetica Rounded statt großer
     Blob-Überschriften */
  .recht h2 {
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    line-height: 1.2;
    text-transform: none;
    letter-spacing: normal;
    color: var(--deep-purple);
    margin: 3rem 0 1rem;
  }
  .recht h3 {
    font-size: 1.15rem;
    color: var(--lavender);
    margin: 2rem 0 0.6rem;
  }
  .recht h4 {
    font-size: 1rem;
    color: var(--deep-purple);
    margin: 1.4rem 0 0.4rem;
  }
  .recht__intro {
    font-weight: 900;
    font-size: 1.1rem;
  }
  .recht ul {
    padding-left: 1.2rem;
    margin: 0 0 1rem;
  }
  .recht li {
    margin-bottom: 0.4rem;
  }
  /* :global – Links kommen teils aus RichText (eigene Komponente) */
  .recht :global(a) {
    color: var(--lavender);
    font-weight: 900;
  }
</style>
