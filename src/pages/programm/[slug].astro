---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { events } from '../../data/site';
import BrandText from '../../components/BrandText.astro';

// Erzeugt für jedes Event aus site.ts eine eigene Unterseite.
export function getStaticPaths() {
  return events.map((event) => ({
    params: { slug: event.slug },
    props: { event },
  }));
}

const { event } = Astro.props;

const accents: Record<string, string> = {
  Diskurs: 'var(--lavender)',
  'Performance & Musik': 'var(--coral)',
  Workshop: 'var(--lime)',
};
const accent = accents[event.category] ?? 'var(--lavender)';
---

<BaseLayout title={event.title} description={event.description}>
  <section class="section section--purple">
    <div class="container narrow">
      <p class="eyebrow">{event.category}</p>
      <h1><BrandText text={event.title} /></h1>
      {event.guest && <p class="lead">mit {event.guest}</p>}
    </div>
  </section>

  <article class="section" style={`--cat:${accent}`}>
    <div class="container narrow">
      <div class="media-placeholder event-hero">Bild folgt</div>

      <p class="lead">{event.description}</p>

      {
        event.bio && (
          <section class="bio">
            <h2>Zur Person</h2>
            <p>{event.bio}</p>
          </section>
        )
      }

      {
        event.partner && (
          <p style="margin-top: 2rem;">
            <span class="tag">In Kooperation mit {event.partner}</span>
          </p>
        )
      }

      <p style="margin-top: 2.5rem;">
        <a class="btn btn--primary btn--on-white" href="/programm">
          ← Zurück zum Programm
        </a>
      </p>
    </div>
  </article>
</BaseLayout>

<style>
  .event-hero {
    aspect-ratio: 16 / 9;
    margin-bottom: 2rem;
    background: var(--cat);
    color: var(--deep-purple);
  }
  .bio {
    margin-top: 2.5rem;
  }
  .bio h2 {
    color: var(--deep-purple);
  }
</style>
