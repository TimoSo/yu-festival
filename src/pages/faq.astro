---
import BaseLayout from '../layouts/BaseLayout.astro';
import RichText from '../components/RichText.astro';
import PageHeader from '../components/PageHeader.astro';
import { faq } from '../data/site';
---

<BaseLayout title="FAQ" description="Häufig gestellte Fragen zum YU Festival.">
  <PageHeader
    eyebrow="FAQ"
    title="Häufige Fragen"
    lead="Die wichtigsten Antworten auf einen Blick. Fehlt etwas? Dann schreib uns gerne."
  />

  <section class="section">
    <div class="container narrow">
      <div class="faq-list">
        {
          faq.map((item) => (
            <details class="faq-item">
              <summary>{item.q}</summary>
              <div class="faq-item__answer">
                <RichText paras={item.a} />
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .faq-list {
    display: grid;
    gap: 1rem;
  }

  .faq-item {
    border: var(--border-w) solid var(--lavender);
    border-radius: var(--radius);
    padding: 0 1.5rem;
    background: var(--white);
  }

  .faq-item summary {
    cursor: pointer;
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: 1.15rem;
    line-height: 1.2;
    color: var(--deep-purple);
    padding: 1.25rem 0;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item summary::after {
    content: '+';
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-pill);
    background: var(--lavender);
    color: var(--white);
    font-size: 1.4rem;
    line-height: 1;
    transition: transform 0.2s ease;
  }
  .faq-item[open] summary::after {
    transform: rotate(45deg);
  }

  .faq-item__answer {
    padding-bottom: 0.6rem;
  }
  .faq-item__answer :global(p) {
    margin: 0 0 0.9rem;
  }
</style>
