---
import BaseLayout from '../layouts/BaseLayout.astro';

const faqs: { q: string; a: string }[] = [
  {
    q: 'Was kostet der Eintritt?',
    a: 'Nichts – das YU Festival ist kostenlos. Tickets braucht ihr nicht.',
  },
  {
    q: 'Worum geht es beim YU Festival?',
    a: 'Um digitale Medien: mit kritischem Blick, aber mit Fokus auf die Gestaltungsmöglichkeiten, die das Individuum und das „Wir" als Kollektiv haben. Inhaltlich teilt es sich in Diskurs, Performance & Musik und Workshops.',
  },
  {
    q: 'Muss ich mich für Workshops anmelden?',
    a: 'Platzhalter: Hier kommt die Info zur Anmeldung für Workshops (z. B. ob und wo man sich registrieren muss).',
  },
  {
    q: 'Wo und wann findet das Festival statt?',
    a: 'Platzhalter: Ort und Termin werden hier ergänzt, sobald sie feststehen.',
  },
  {
    q: 'Wer steckt hinter dem Festival?',
    a: 'Platzhalter: Veranstalter:innen und Partner – u. a. das kiU und das KoLab, das Digitale Koproduktionslabor der Stadt Dortmund.',
  },
];
---

<BaseLayout title="FAQ" description="Häufig gestellte Fragen zum YU Festival.">
  <section class="section section--lime">
    <div class="container narrow">
      <p class="eyebrow">FAQ</p>
      <h1>Häufige Fragen</h1>
      <p class="lead">
        Die wichtigsten Antworten auf einen Blick. Fehlt etwas? Dann ergänzen wir
        es hier.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <div class="faq-list">
        {
          faqs.map((item) => (
            <details class="faq-item">
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .faq-list {
    display: grid;
    gap: 1rem;
  }

  .faq-item {
    border: var(--border-w) solid var(--lavender);
    border-radius: var(--radius);
    padding: 0 1.5rem;
    background: var(--white);
  }

  .faq-item summary {
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 400; /* Blob: nur ein Schnitt */
    font-size: 1.2rem;
    line-height: 1.2;
    color: var(--deep-purple);
    padding: 1.25rem 0;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item summary::after {
    content: '+';
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-pill);
    background: var(--lavender);
    color: var(--white);
    font-size: 1.4rem;
    line-height: 1;
    transition: transform 0.2s ease;
  }
  .faq-item[open] summary::after {
    transform: rotate(45deg);
  }

  .faq-item p {
    margin: 0;
    padding-bottom: 1.5rem;
  }
</style>
