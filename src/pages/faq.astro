---
import BaseLayout from '../layouts/BaseLayout.astro';

const faqs: { q: string; a: string }[] = [
  {
    q: 'Was kostet der Eintritt?',
    a: 'Nichts – das YU Festival ist kostenlos. Tickets braucht ihr nicht.',
  },
  {
    q: 'Worum geht es beim YU Festival?',
    a: 'Um digitale Medien: mit kritischem Blick, aber mit Fokus auf die Gestaltungsmöglichkeiten, die das Individuum und das „Wir" als Kollektiv haben. Inhaltlich teilt es sich in Diskurs, Performance & Musik und Workshops.',
  },
  {
    q: 'Muss ich mich für Workshops anmelden?',
    a: 'Platzhalter: Hier kommt die Info zur Anmeldung für Workshops (z. B. ob und wo man sich registrieren muss).',
  },
  {
    q: 'Wo und wann findet das Festival statt?',
    a: 'Platzhalter: Ort und Termin werden hier ergänzt, sobald sie feststehen.',
  },
  {
    q: 'Wer steckt hinter dem Festival?',
    a: 'Platzhalter: Veranstalter:innen und Partner – u. a. das kiU und das KoLab, das Digitale Koproduktionslabor der Stadt Dortmund.',
  },
];
---

<BaseLayout title="FAQ" description="Häufig gestellte Fragen zum YU Festival.">
  <section class="section container narrow">
    <p class="eyebrow">FAQ</p>
    <h1>Häufige Fragen</h1>
    <p class="lead">
      Die wichtigsten Antworten auf einen Blick. Fehlt etwas? Dann ergänzen wir es
      hier.
    </p>

    <div class="faq-list">
      {
        faqs.map((item) => (
          <details class="faq-item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .faq-list {
    margin-top: 2.5rem;
    display: grid;
    gap: 0.75rem;
  }

  .faq-item {
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0 1.5rem;
  }

  .faq-item summary {
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--color-text);
    padding: 1.25rem 0;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item summary::after {
    content: '+';
    color: var(--color-petrol);
    font-size: 1.5rem;
    line-height: 1;
    transition: transform 0.2s ease;
  }
  .faq-item[open] summary::after {
    transform: rotate(45deg);
  }

  .faq-item p {
    margin: 0;
    padding-bottom: 1.25rem;
    color: var(--color-text-muted);
  }
</style>
