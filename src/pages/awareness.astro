---
import BaseLayout from '../layouts/BaseLayout.astro';
import { contact } from '../data/site';
---

<BaseLayout
  title="Awareness"
  description="Das Awareness-Konzept des YU Festivals: ein respektvoller, sicherer Raum für alle."
>
  <section class="section section--purple">
    <div class="container narrow">
      <p class="eyebrow">Awareness</p>
      <h1>Awareness</h1>
      <p class="lead">
        Das YU Festival soll ein Ort sein, an dem sich alle wohl und sicher
        fühlen. Wir setzen uns für einen respektvollen, diskriminierungsfreien
        Umgang ein.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>Unser Anspruch</h2>
      <p>
        Platzhaltertext: Hier beschreiben wir die Haltung des Festivals – ein
        Raum, in dem unterschiedliche Menschen, Perspektiven und Ausdrucksformen
        willkommen sind. Diskriminierung, Übergriffigkeit und
        Grenzüberschreitungen haben bei uns keinen Platz.
      </p>

      <h2 style="margin-top: 2.5rem;">Während des Festivals</h2>
      <p>
        Platzhaltertext: Informationen zum Awareness-Team, zu Anlaufstellen vor
        Ort und dazu, wie ihr Unterstützung bekommt, wenn ihr euch unwohl fühlt
        oder etwas beobachtet.
      </p>

      <h2 style="margin-top: 2.5rem;">Kontakt</h2>
      <p>
        Bei Anliegen rund um Awareness erreicht ihr uns unter
        <a href={`mailto:${contact.email}`}>{contact.email}</a>. Weitere
        Anlaufstellen vor Ort ergänzen wir hier.
      </p>
    </div>
  </section>
</BaseLayout>
