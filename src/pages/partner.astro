---
import BaseLayout from '../layouts/BaseLayout.astro';
import { partners } from '../data/site';
---

<BaseLayout
  title="Partner"
  description="Die Kooperationspartner des YU Festivals – u. a. kiU und KoLab."
>
  <section class="section section--coral">
    <div class="container">
      <p class="eyebrow">In Kooperation mit</p>
      <h1>Partner</h1>
      <p class="lead">
        Das YU Festival entsteht gemeinsam mit starken Partnern aus Kultur und
        digitaler Produktion.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid--2">
        {
          partners.map((partner) => (
            <article class="partner-card">
              <div class="partner-logo">{partner.name}</div>
              <div>
                <h3>{partner.name}</h3>
                <p class="tag">{partner.role}</p>
                <p style="margin-top: 0.75rem;">{partner.description}</p>
                {partner.url && (
                  <a href={partner.url} rel="noopener">Website →</a>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .partner-card {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 1.5rem;
    align-items: start;
    border: var(--border-w) solid var(--lavender);
    border-radius: var(--radius);
    padding: 1.75rem;
  }
  .partner-logo {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    border-radius: var(--radius-sm);
    background: var(--lavender);
    color: var(--white);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.3rem;
  }
  @media (max-width: 480px) {
    .partner-card {
      grid-template-columns: 1fr;
    }
    .partner-logo {
      width: 5rem;
    }
  }
</style>
