---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { contact } from '../data/site';
import IconInstagram from '../components/IconInstagram.astro';

// Bewusst ohne Kontaktformular: Ein Formular bräuchte einen Dienst oder
// Server, der die Nachrichten weiterleitet (Datenschutzhinweis, oft
// Spamschutz mit Cookies). Ein Mail-Link kommt ohne all das aus.
---

<BaseLayout title="Kontakt" description="Kontakt zum YU Festival – schreib uns.">
  <PageHeader
    eyebrow="Kontakt"
    title="Schreib uns"
    lead={contact.note}
  />

  <section class="section">
    <div class="container narrow">
      <a class="mail-cta" href={`mailto:${contact.email}`}>{contact.email}</a>
      <a class="insta-cta" href={contact.instagram} target="_blank" rel="noopener noreferrer">
        <IconInstagram /> {contact.instagramName} auf Instagram
      </a>
      <p class="kontakt-faq">
        Viele Antworten findest du auch in den <a href="/faq">häufigen Fragen</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .mail-cta {
    display: inline-block;
    margin-bottom: 2rem;
    /* bewusst Helvetica Rounded: Blob fehlt das "@" */
    font-family: var(--font-sans);
    font-size: clamp(1.4rem, 4vw, 2.2rem);
    font-weight: 900;
    line-height: 1.1;
    color: var(--lavender);
    text-decoration: none;
    border-bottom: 6px solid var(--lime);
  }
  .mail-cta:hover {
    color: var(--deep-purple);
    border-color: var(--coral);
  }
  .insta-cta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    margin: -0.75rem 0 2rem;
    font-size: clamp(1.1rem, 2.6vw, 1.4rem);
    font-weight: 900;
    color: var(--deep-purple);
    text-decoration: none;
  }
  .insta-cta:hover {
    color: var(--lavender);
  }
  .kontakt-faq {
    margin: 0;
  }
  .kontakt-faq a {
    font-weight: 900;
    color: var(--lavender);
  }
</style>
