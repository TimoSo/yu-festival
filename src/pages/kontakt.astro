---
import BaseLayout from '../layouts/BaseLayout.astro';
import { contact } from '../data/site';
---

<BaseLayout title="Kontakt" description="Kontakt zum YU Festival – schreib uns.">
  <section class="section section--lavender">
    <div class="container narrow">
      <p class="eyebrow">Kontakt</p>
      <h1>Schreib uns</h1>
      <p class="lead">{contact.note}</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <a class="mail-cta" href={`mailto:${contact.email}`}>{contact.email}</a>

      <!-- Formular-Gerüst: optisch fertig, aber noch nicht versendend.
           Anbindung (z. B. Formspree, Netlify Forms o. ä.) folgt. -->
      <form class="contact-form" aria-describedby="form-hint">
        <p id="form-hint" class="form-hint">
          Hinweis: Das Formular ist noch nicht angebunden – bitte nutzt vorerst
          die E-Mail-Adresse oben.
        </p>
        <label>
          Name
          <input type="text" name="name" autocomplete="name" disabled />
        </label>
        <label>
          E-Mail
          <input type="email" name="email" autocomplete="email" disabled />
        </label>
        <label>
          Nachricht
          <textarea name="message" rows="5" disabled></textarea>
        </label>
        <button class="btn btn--primary btn--on-white" type="submit" disabled>
          Senden
        </button>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .mail-cta {
    display: inline-block;
    margin-bottom: 2.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4.5vw, 2.6rem);
    font-weight: 800;
    line-height: 1.1;
    color: var(--lavender);
    text-decoration: none;
    border-bottom: 6px solid var(--lime);
  }
  .mail-cta:hover {
    color: var(--deep-purple);
    border-color: var(--coral);
  }

  .contact-form {
    display: grid;
    gap: 1.25rem;
    max-width: 540px;
  }
  .form-hint {
    margin: 0;
    padding: 0.9rem 1.2rem;
    border-radius: var(--radius-sm);
    background: var(--lime);
    color: var(--deep-purple);
    font-weight: 700;
    font-size: 0.95rem;
  }
  .contact-form label {
    display: grid;
    gap: 0.4rem;
    font-weight: 800;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--deep-purple);
  }
  .contact-form input,
  .contact-form textarea {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1rem;
    text-transform: none;
    letter-spacing: normal;
    color: var(--black);
    background: var(--white);
    border: 3px solid var(--lavender);
    border-radius: var(--radius-sm);
    padding: 0.8rem 1rem;
  }
  .contact-form input:focus,
  .contact-form textarea:focus {
    outline: 3px solid var(--lime);
    outline-offset: 2px;
  }
  .contact-form button[disabled] {
    opacity: 0.55;
    cursor: not-allowed;
  }
</style>
