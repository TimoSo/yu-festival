---
import BaseLayout from '../layouts/BaseLayout.astro';
import { contact } from '../data/site';
---

<BaseLayout
  title="Kontakt"
  description="Kontakt zum YU Festival – schreib uns."
>
  <section class="section container narrow">
    <p class="eyebrow">Kontakt</p>
    <h1>Schreib uns</h1>
    <p class="lead">{contact.note}</p>

    <a class="mail-cta" href={`mailto:${contact.email}`}>{contact.email}</a>

    <!-- Formular-Gerüst: optisch fertig, aber noch nicht versendend.
         Anbindung (z. B. Formspree, Netlify Forms o. ä.) folgt. -->
    <form class="contact-form" aria-describedby="form-hint">
      <p id="form-hint" class="form-hint tag">
        Hinweis: Das Formular ist noch nicht angebunden – bitte nutzt vorerst die
        E-Mail-Adresse oben.
      </p>
      <label>
        Name
        <input type="text" name="name" autocomplete="name" disabled />
      </label>
      <label>
        E-Mail
        <input type="email" name="email" autocomplete="email" disabled />
      </label>
      <label>
        Nachricht
        <textarea name="message" rows="5" disabled></textarea>
      </label>
      <button class="btn btn--primary" type="submit" disabled>Senden</button>
    </form>
  </section>
</BaseLayout>

<style>
  .mail-cta {
    display: inline-block;
    margin: 1.5rem 0 2.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 4vw, 2.2rem);
    font-weight: 700;
    color: var(--color-weintor);
    text-decoration: none;
    border-bottom: 3px solid var(--color-petrol);
  }
  .mail-cta:hover {
    color: var(--color-petrol);
    border-color: var(--color-weintor);
  }

  .contact-form {
    display: grid;
    gap: 1.1rem;
    max-width: 520px;
  }
  .form-hint {
    color: var(--color-text-muted);
  }
  .contact-form label {
    display: grid;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }
  .contact-form input,
  .contact-form textarea {
    font-family: var(--font-sans);
    font-size: 1rem;
    text-transform: none;
    letter-spacing: normal;
    color: var(--color-text);
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 0.7rem 0.85rem;
  }
  .contact-form input:focus,
  .contact-form textarea:focus {
    outline: 2px solid var(--color-petrol);
    border-color: var(--color-petrol);
  }
  .contact-form button[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
  }
</style>
