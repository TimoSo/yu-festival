---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Deco from '../components/Deco.astro';
import Kurzvorstellung from '../components/Kurzvorstellung.astro';
import { landing, pillars, partners } from '../data/site';
---

<BaseLayout>
  <Hero />

  <!-- Worum es geht -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow">Worum es geht</p>
      <h2>Digitale Räume gestalten</h2>
      <p class="lead">{landing.worum.lead}</p>
      <p>{landing.worum.text}</p>
    </div>
  </section>

  <Kurzvorstellung />

  <!-- Die drei Säulen -->
  <section class="section section--lime">
    <div class="container">
      <p class="eyebrow">Drei Säulen</p>
      <h2>Diskurs&nbsp;· Workshops&nbsp;· Digitale Kunst und Performances</h2>
      <div class="grid grid--3" style="margin-top: 2.5rem;">
        {
          pillars.map((pillar) => (
            <article class="card pillar" style={`--pillar: ${pillar.accent}`}>
              <h3>{pillar.title}</h3>
              <p>{pillar.text}</p>
            </article>
          ))
        }
      </div>
      <p style="margin-top: 2.5rem;">
        <a class="btn btn--primary" href="/programm">Zum Programm</a>
      </p>
    </div>
  </section>

  <!-- Partner -->
  <section class="section section--coral">
    <div class="container">
      <div class="partner-head">
        <div>
          <p class="eyebrow">In Kooperation mit</p>
          <h2>Partner</h2>
        </div>
        <div class="partner-squiggle">
          <Deco shape="squiggle" width="200px" />
        </div>
      </div>

      <ul class="partner-list">
        {
          partners.map((partner) => (
            <li>
              <a class="card partner-chip" href={`/partner#${partner.id}`}>
                <span class="partner-chip__name">{partner.name}</span>
                {partner.full && (
                  <span class="partner-chip__full">{partner.full}</span>
                )}
                <span class="partner-chip__mehr" aria-hidden="true">Mehr erfahren →</span>
              </a>
            </li>
          ))
        }
      </ul>

      <p style="margin-top: 2.5rem;">
        <a class="btn btn--ghost" href="/partner">Alle Partner ansehen</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .pillar {
    border-bottom: 10px solid var(--pillar);
  }
  .partner-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .partner-squiggle {
    color: var(--deep-purple);
  }

  .partner-list {
    list-style: none;
    display: grid;
    gap: 1rem;
    margin: 2rem 0 0;
    padding: 0;
  }
  @media (min-width: 760px) {
    .partner-list {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  /* Jede Kachel springt zum Partner auf der Partnerseite */
  .partner-chip {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    height: 100%;
    padding: 1.25rem 1.5rem;
    text-decoration: none;
  }
  .partner-chip:hover {
    box-shadow: 6px 6px 0 var(--deep-purple);
  }
  .partner-chip__name {
    font-weight: 900;
    font-size: 1.2rem;
  }
  .partner-chip__full {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--lavender);
  }
  .partner-chip__mehr {
    margin-top: auto;
    padding-top: 0.6rem;
    font-weight: 900;
    font-size: 0.85rem;
    color: var(--deep-purple);
  }
</style>
