---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { pillars, partners } from '../data/site';
---

<BaseLayout>
  <Hero />

  <!-- Worum es geht -->
  <section class="section container">
    <p class="eyebrow">Worum es geht</p>
    <h2>Digitale Medien gestalten – <span class="text-petrol">allein</span> und
      <span class="text-weintor">gemeinsam</span></h2>
    <p class="lead">
      Das YU Festival beschäftigt sich mit digitalen Medien. Den kritischen Blick
      vergessen wir nicht – unser Fokus liegt aber auf den
      Gestaltungsmöglichkeiten, die das Individuum und das „Wir" als
      Kollektivgedanken haben.
    </p>
  </section>

  <!-- Die drei Säulen -->
  <section class="section section--muted">
    <div class="container">
      <p class="eyebrow">Drei Säulen, je ein Drittel</p>
      <h2>Diskurs · Performance &amp; Musik · Workshops</h2>
      <div class="grid grid--3" style="margin-top: 2.5rem;">
        {
          pillars.map((pillar) => (
            <article class="card pillar" style={`--pillar: ${pillar.accent}`}>
              <span class="pillar__share">{pillar.share}</span>
              <h3>{pillar.title}</h3>
              <p>{pillar.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Partner-Vorschau -->
  <section class="section container">
    <p class="eyebrow">In Kooperation mit</p>
    <h2>Partner</h2>
    <div class="grid grid--2" style="margin-top: 2.5rem;">
      {
        partners.map((partner) => (
          <article class="card">
            <h3>{partner.name}</h3>
            <p class="tag">{partner.role}</p>
            <p>{partner.description}</p>
          </article>
        ))
      }
    </div>
    <p style="margin-top: 2rem;">
      <a class="btn btn--ghost" href="/partner">Alle Partner ansehen</a>
    </p>
  </section>
</BaseLayout>

<style>
  .pillar {
    border-top: 4px solid var(--pillar);
  }
  .pillar__share {
    display: inline-block;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--pillar);
    margin-bottom: 0.5rem;
  }
</style>
