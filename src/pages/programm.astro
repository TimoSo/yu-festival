---
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from '../components/EventCard.astro';
import RichText from '../components/RichText.astro';
import { tracks, days, events, ongoing, anmeldung } from '../data/programm';

// Farbe je Kategorie, pro Bereich eigene Zuordnung
function accentOf(trackId: string, category: string): string {
  const track = tracks.find((t) => t.id === trackId);
  const cat = track?.categories.find((c) => c.name === category);
  return cat?.accent ?? 'var(--lavender)';
}

// Programmpunkte eines Tages, nach Beginn sortiert
function eventsOf(trackId: string, day: number) {
  return events
    .filter((e) => e.track === trackId && e.day === day)
    .sort((a, b) => a.start.localeCompare(b.start));
}
---

<BaseLayout
  title="Programm"
  description="Das Programm des YU Festivals vom 22. bis 25. Oktober 2026 im Dortmunder U: Festival, Konferenz und Hackathon."
>
  <section class="section programm">
    <div class="container">
      <h1 class="visually-hidden">Programm</h1>

      <!-- Filterleiste: schaltet zwischen den drei Bereichen um -->
      <div class="switch-bar">
        <div class="switch" role="tablist" aria-label="Programmbereich wählen">
          <span class="switch__thumb" aria-hidden="true"></span>
          <span class="switch__ghost" aria-hidden="true"></span>
          {
            tracks.map((track, i) => (
              <button
                type="button"
                class="switch__btn"
                role="tab"
                id={`tab-${track.id}`}
                data-track={track.id}
                aria-controls={`panel-${track.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
              >
                {track.label}
              </button>
            ))
          }
        </div>
      </div>

      <!-- Je Bereich ein Zeitplan -->
      {
        tracks.map((track, ti) => (
          <div
            class="track"
            id={`panel-${track.id}`}
            role="tabpanel"
            aria-labelledby={`tab-${track.id}`}
            data-track={track.id}
            hidden={ti !== 0}
          >
            <div class="track__intro">
              {track.intro.title && (
                <h2 class="track__title">{track.intro.title}</h2>
              )}
              {track.intro.meta && <p class="track__meta">{track.intro.meta}</p>}
              <RichText paras={track.intro.text} />
              {track.intro.link && (
                <p>
                  <a
                    class="track__link"
                    href={track.intro.link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {track.intro.link.label} →
                  </a>
                </p>
              )}
              {track.intro.registration && (
                <div class="track__anmeldung">
                  <RichText paras={[anmeldung.text]} />
                  <a
                    class="btn btn--primary btn--on-white"
                    href={`mailto:${anmeldung.email}?subject=${encodeURIComponent(
                      `Anmeldung: ${track.label}`
                    )}`}
                  >
                    Per E-Mail anmelden
                  </a>
                </div>
              )}
            </div>

            <div class="legend">
              {track.categories.map((cat) => (
                <span class="legend__item">
                  <span class="legend__dot" style={`background:${cat.accent}`} />
                  {cat.name}
                </span>
              ))}
            </div>

            {days.map((day) => {
              const dayEvents = eventsOf(track.id, day.nr);
              if (dayEvents.length === 0) return null;
              return (
                <section class="day">
                  <h2 class="day__head">
                    {day.weekday}
                    <span class="day__date">{day.date}</span>
                  </h2>

                  <ol class="timeline">
                    {dayEvents.map((event) => (
                      <li
                        class="row"
                        style={`--cat:${accentOf(track.id, event.category)}`}
                      >
                        <span class="row__time">
                          <span class="row__start">{event.start}</span>
                          {event.end && (
                            <span class="row__end">–{event.end}</span>
                          )}
                        </span>
                        <span class="row__rail" aria-hidden="true">
                          <span class="row__dot" />
                        </span>
                        <EventCard item={event} tag={event.category} />
                      </li>
                    ))}
                  </ol>
                </section>
              );
            })}
          </div>
        ))
      }

      <!-- Ausstellungen laufen an allen vier Tagen und gelten für alle
           Bereiche. Sie stehen bewusst unter dem Zeitplan, damit das
           Programm zuerst kommt. -->
      <section class="day ongoing" aria-labelledby="ongoing-head">
        <h2 class="day__head" id="ongoing-head">
          Ausstellungen
          <span class="day__date">durchgehend an allen vier Tagen</span>
        </h2>
        <div class="ongoing__grid">
          {
            ongoing.map((item) => (
              <EventCard item={item} tag={item.period} variant="ongoing" />
            ))
          }
        </div>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .programm {
    padding-top: clamp(2rem, 5vw, 3.5rem);
  }

  /* ---------- Filterleiste (iOS-artiger Umschalter) ---------- */
  .switch-bar {
    display: flex;
    justify-content: center;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .switch {
    position: relative;
    display: inline-flex;
    gap: 0.25rem;
    padding: 0.4rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--lavender) 14%, var(--white));
    /* leichte, zum Cursor entgegengesetzte Verschiebung (per JS gesetzt) */
    transform: translate(var(--shift-x, 0px), var(--shift-y, 0px));
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    max-width: 100%;
  }

  .switch__thumb,
  .switch__ghost {
    position: absolute;
    top: 0.4rem;
    left: 0;
    height: calc(100% - 0.8rem);
    border-radius: var(--radius-pill);
    width: var(--thumb-w, 0px);
    transform: translateX(var(--thumb-x, 0px));
    transition:
      transform 0.42s cubic-bezier(0.22, 1, 0.36, 1),
      width 0.42s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.25s ease;
    pointer-events: none;
  }
  .switch__thumb {
    background: var(--lavender);
    z-index: 0;
  }
  /* Vorschau beim Überfahren – deutet die Bewegung an */
  .switch__ghost {
    background: var(--lavender);
    opacity: 0;
    width: var(--ghost-w, 0px);
    transform: translateX(var(--ghost-x, 0px));
    z-index: 0;
  }
  .switch.has-ghost .switch__ghost {
    opacity: 0.28;
  }

  .switch__btn {
    position: relative;
    z-index: 1;
    appearance: none;
    border: 0;
    background: none;
    cursor: pointer;
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: clamp(0.9rem, 2vw, 1.05rem);
    letter-spacing: 0.02em;
    color: var(--deep-purple);
    padding: 0.7rem clamp(1rem, 3vw, 1.9rem);
    border-radius: var(--radius-pill);
    transition: color 0.3s ease;
    white-space: nowrap;
  }
  .switch__btn[aria-selected='true'] {
    color: var(--white);
  }

  /* ---------- Ausstellungen (unter dem Zeitplan) ---------- */
  .ongoing {
    margin-top: clamp(1rem, 3vw, 2rem);
    padding-top: clamp(2rem, 5vw, 3rem);
    border-top: 4px solid color-mix(in srgb, var(--deep-purple) 12%, transparent);
  }
  .ongoing__grid {
    display: grid;
    gap: 1rem;
    align-items: start;
  }
  @media (min-width: 760px) {
    .ongoing__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* ---------- Bereichs-Einleitung ---------- */
  .track__intro {
    max-width: 70ch;
    margin-bottom: 1.75rem;
  }
  .track__title {
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: clamp(1.3rem, 3vw, 1.75rem);
    line-height: 1.2;
    text-transform: none;
    color: var(--deep-purple);
    margin-bottom: 0.6rem;
  }
  .track__meta {
    display: inline-block;
    font-weight: 900;
    font-size: 0.9rem;
    padding: 0.35rem 0.9rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--lavender) 14%, var(--white));
    color: var(--deep-purple);
  }
  .track__link {
    font-weight: 900;
    color: var(--lavender);
  }
  .track__anmeldung {
    margin-top: 1rem;
    padding: 1rem 1.2rem;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--lavender) 12%, var(--white));
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-bottom: 2.5rem;
    font-weight: 900;
    font-size: 0.9rem;
  }
  .legend__item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .legend__dot {
    width: 1.1rem;
    height: 1.1rem;
    border-radius: var(--radius-pill);
  }

  /* ---------- Zeitplan ---------- */
  .day {
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }
  .day__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.9rem;
    font-size: clamp(1.5rem, 3.5vw, 2.2rem);
    margin-bottom: 1.25rem;
    color: var(--deep-purple);
  }
  .day__date {
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: 0.85rem;
    text-transform: none;
    letter-spacing: 0.04em;
    color: var(--lavender);
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .row {
    display: grid;
    grid-template-columns: 4.5rem 1.75rem minmax(0, 1fr);
    gap: 1rem;
    align-items: stretch;
  }
  .row__time {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    padding-top: 1.05rem;
    color: var(--deep-purple);
    line-height: 1.2;
  }
  .row__start {
    font-weight: 900;
  }
  .row__end {
    font-weight: 700;
    font-size: 0.8rem;
    opacity: 0.7;
  }

  /* durchgehende Linie + Punkt */
  .row__rail {
    position: relative;
    display: flex;
    justify-content: center;
  }
  .row__rail::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 4px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--deep-purple) 18%, transparent);
  }
  .row:first-child .row__rail::before {
    top: 1.1rem;
  }
  .row:last-child .row__rail::before {
    bottom: auto;
    height: 1.1rem;
  }
  .row__dot {
    position: relative;
    margin-top: 1rem;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: var(--radius-pill);
    background: var(--cat);
    flex-shrink: 0;
  }

  @media (max-width: 560px) {
    .row {
      grid-template-columns: 3.2rem 1.25rem minmax(0, 1fr);
      gap: 0.6rem;
    }
    .row__start {
      font-size: 0.9rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .switch,
    .switch__thumb,
    .switch__ghost {
      transition: none;
    }
  }
</style>

<script>
  // ---------- Umschalter ----------
  const switchEl = document.querySelector<HTMLElement>('.switch');
  const buttons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('.switch__btn')
  );
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.track'));

  function moveThumb(btn: HTMLElement, prefix: 'thumb' | 'ghost') {
    if (!switchEl) return;
    switchEl.style.setProperty(`--${prefix}-w`, `${btn.offsetWidth}px`);
    switchEl.style.setProperty(`--${prefix}-x`, `${btn.offsetLeft}px`);
  }

  const aktiverButton = () =>
    buttons.find((b) => b.getAttribute('aria-selected') === 'true') ??
    buttons[0];

  function activate(id: string) {
    buttons.forEach((b) => {
      const on = b.dataset.track === id;
      b.setAttribute('aria-selected', String(on));
      b.tabIndex = on ? 0 : -1;
      if (on) moveThumb(b, 'thumb');
    });
    panels.forEach((p) => {
      p.hidden = p.dataset.track !== id;
    });
  }

  if (switchEl && buttons.length) {
    moveThumb(aktiverButton(), 'thumb');
    // nach dem Laden der Schriften kann sich die Breite noch aendern
    document.fonts?.ready.then(() => moveThumb(aktiverButton(), 'thumb'));
    window.addEventListener('resize', () => moveThumb(aktiverButton(), 'thumb'));

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => activate(btn.dataset.track!));

      // Hover deutet die Bewegung schon an
      btn.addEventListener('mouseenter', () => {
        if (btn.getAttribute('aria-selected') === 'true') {
          switchEl.classList.remove('has-ghost');
          return;
        }
        moveThumb(btn, 'ghost');
        switchEl.classList.add('has-ghost');
      });

      // Pfeiltasten wie bei Tabs ueblich
      btn.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        e.preventDefault();
        const i = buttons.indexOf(btn);
        const next =
          e.key === 'ArrowRight'
            ? buttons[(i + 1) % buttons.length]
            : buttons[(i - 1 + buttons.length) % buttons.length];
        activate(next.dataset.track!);
        next.focus();
      });
    });

    switchEl.addEventListener('mouseleave', () => {
      switchEl.classList.remove('has-ghost');
      switchEl.style.setProperty('--shift-x', '0px');
      switchEl.style.setProperty('--shift-y', '0px');
    });

    // leichte, zum Cursor entgegengesetzte Verschiebung der ganzen Leiste
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    switchEl.addEventListener('mousemove', (e) => {
      if (reduced.matches) return;
      const r = switchEl.getBoundingClientRect();
      const dx = (e.clientX - (r.left + r.width / 2)) / (r.width / 2);
      const dy = (e.clientY - (r.top + r.height / 2)) / (r.height / 2);
      switchEl.style.setProperty('--shift-x', `${(-dx * 7).toFixed(2)}px`);
      switchEl.style.setProperty('--shift-y', `${(-dy * 4).toFixed(2)}px`);
    });
  }
</script>
