---
import BaseLayout from '../layouts/BaseLayout.astro';
import { events } from '../data/site';

const categories = ['Diskurs', 'Performance & Musik', 'Workshop'] as const;
const accents: Record<(typeof categories)[number], string> = {
  Diskurs: 'var(--lavender)',
  'Performance & Musik': 'var(--coral)',
  Workshop: 'var(--lime)',
};
---

<BaseLayout
  title="Programm"
  description="Das Programm des YU Festivals: Diskurs, Performance & Musik und Workshops – mit Kurzbeschreibungen und Gast-Bios."
>
  <section class="section section--lavender">
    <div class="container">
      <p class="eyebrow">Programm</p>
      <h1>Programm</h1>
      <p class="lead">
        Je ein Drittel Diskurs, Performance &amp; Musik und Workshops. Klick auf
        eine Veranstaltung für Details und Gast-Infos.
      </p>
    </div>
  </section>

  {
    categories.map((cat) => {
      const items = events.filter((e) => e.category === cat);
      return (
        <section class="section cat" style={`--cat: ${accents[cat]}`}>
          <div class="container">
            <h2 class="cat__head">
              <span class="cat__bar" />
              {cat}
            </h2>
            <div class="grid grid--3" style="margin-top: 1.75rem;">
              {items.map((event) => (
                <a class="event-card" href={`/programm/${event.slug}`}>
                  <div class="media-placeholder event-card__media">Bild folgt</div>
                  <h3>{event.title}</h3>
                  {event.guest && (
                    <p class="event-card__guest">mit {event.guest}</p>
                  )}
                  <p class="event-card__desc">{event.description}</p>
                  <span class="event-card__more">Mehr →</span>
                </a>
              ))}
            </div>
          </div>
        </section>
      );
    })
  }
</BaseLayout>

<style>
  .cat {
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }

  .cat__head {
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--deep-purple);
  }
  .cat__bar {
    display: inline-block;
    width: 3.5rem;
    height: 1rem;
    border-radius: var(--radius-pill);
    background: var(--cat);
    flex-shrink: 0;
  }

  .event-card {
    display: flex;
    flex-direction: column;
    border: var(--border-w) solid var(--cat);
    border-radius: var(--radius);
    padding: 1rem;
    text-decoration: none;
    color: var(--black);
    background: var(--white);
    transition: transform 0.15s ease, background 0.15s ease;
  }
  .event-card:hover {
    transform: translate(-3px, -3px);
    background: color-mix(in srgb, var(--cat) 14%, var(--white));
  }

  .event-card__media {
    aspect-ratio: 16 / 10;
    margin-bottom: 1rem;
    background: var(--cat);
    color: var(--deep-purple);
  }

  .event-card h3 {
    margin-bottom: 0.35rem;
  }
  .event-card__guest {
    font-weight: 800;
    color: var(--lavender);
    margin: 0 0 0.5rem;
  }
  .event-card__desc {
    flex-grow: 1;
    margin-bottom: 0.75rem;
  }
  .event-card__more {
    font-weight: 800;
    color: var(--deep-purple);
  }
</style>
