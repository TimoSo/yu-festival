---
import BaseLayout from '../layouts/BaseLayout.astro';
import { events } from '../data/site';

const accents: Record<string, string> = {
  Diskurs: 'var(--lavender)',
  'Performance & Musik': 'var(--coral)',
  Workshop: 'var(--lime)',
};

// Platzhalter-Slots: Reihenfolge = grober Tagesverlauf.
// Sobald Uhrzeiten feststehen, hier eintragen.
const slots = events.map((e) => ({ time: 'tba', ...e }));
---

<BaseLayout
  title="Timetable"
  description="Visueller Überblick über den Ablauf des YU Festivals."
>
  <section class="section section--lime">
    <div class="container">
      <p class="eyebrow">Timetable</p>
      <h1>Ablauf</h1>
      <p class="lead">
        Ein visueller Überblick über das Festival. Die genauen Uhrzeiten folgen –
        die Reihenfolge zeigt schon mal den groben Verlauf.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="legend">
        {
          Object.entries(accents).map(([cat, color]) => (
            <span class="legend__item">
              <span class="legend__dot" style={`background:${color}`} />
              {cat}
            </span>
          ))
        }
      </div>

      <ol class="timeline">
        {
          slots.map((slot) => (
            <li class="timeline__row" style={`--cat:${accents[slot.category]}`}>
              <span class="timeline__time">{slot.time}</span>
              <span class="timeline__node" />
              <a class="timeline__event" href={`/programm/${slot.slug}`}>
                <span class="tag timeline__cat">{slot.category}</span>
                <span class="timeline__title">{slot.title}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
    font-weight: 800;
    font-size: 0.9rem;
  }
  .legend__item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .legend__dot {
    width: 1.1rem;
    height: 1.1rem;
    border-radius: var(--radius-pill);
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .timeline__row {
    display: grid;
    grid-template-columns: 5rem 1.75rem 1fr;
    align-items: center;
    gap: 1rem;
    padding-block: 0.4rem;
  }
  .timeline__time {
    font-weight: 800;
    text-align: right;
    color: var(--deep-purple);
  }
  .timeline__node {
    justify-self: center;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: var(--radius-pill);
    background: var(--cat);
    position: relative;
  }
  .timeline__row:not(:last-child) .timeline__node::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    width: 4px;
    border-radius: 999px;
    height: calc(100% + 0.8rem);
    background: color-mix(in srgb, var(--deep-purple) 20%, transparent);
  }

  .timeline__event {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
    padding: 0.9rem 1.2rem;
    border: var(--border-w) solid var(--cat);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--black);
    transition: transform 0.15s ease, background 0.15s ease;
  }
  .timeline__event:hover {
    transform: translateX(4px);
    background: color-mix(in srgb, var(--cat) 14%, var(--white));
  }
  .timeline__cat {
    background: var(--cat);
    color: var(--deep-purple);
  }
  .timeline__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.2rem;
    line-height: 1.1;
  }

  @media (max-width: 560px) {
    .timeline__row {
      grid-template-columns: 3.5rem 1.25rem 1fr;
      gap: 0.6rem;
    }
  }
</style>
