---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, about } from '../../data/site';
---

<BaseLayout
  title="Über das Festival"
  description="Über das YU Festival – wie wollen wir digital zusammenleben?"
>
  <section class="section section--lavender">
    <div class="container narrow">
      <p class="eyebrow">About</p>
      <h1>Über das Festival</h1>
      <p class="lead">{about.lead}</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>{about.titel}</h2>
      <p class="lead about__frage">{about.frage}</p>
      {about.text.map((absatz) => <p>{absatz}</p>)}
    </div>
  </section>

  <section class="section section--lime">
    <div class="container narrow">
      <h2>Eckdaten</h2>
      <dl class="facts">
        <div><dt>Termin</dt><dd>{site.date}</dd></div>
        <div><dt>Ort</dt><dd>{site.location}</dd></div>
        <div>
          <dt>Eintritt</dt>
          <dd>frei – für einige Veranstaltungen ist eine Anmeldung nötig</dd>
        </div>
      </dl>

      <p style="margin-top: 2.5rem;">
        <a class="btn btn--primary" href="/programm">Zum Programm</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .about__frage {
    color: var(--lavender);
    margin-bottom: 1.5rem;
  }
  .facts {
    display: grid;
    gap: 0.75rem;
    margin: 1.5rem 0 0;
  }
  .facts > div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    border-bottom: 3px solid color-mix(in srgb, var(--deep-purple) 25%, transparent);
    padding-bottom: 0.6rem;
  }
  .facts dt {
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.85rem;
    min-width: 7rem;
    margin: 0;
  }
  .facts dd {
    margin: 0;
    font-weight: 900;
  }
</style>
