# Build-Output
dist/
.output/

# Abhängigkeiten
node_modules/

# Astro
.astro/

# Logs
*.log
npm-debug.log*

# Umgebungsvariablen
.env
.env.*
!.env.example

# CI-Quellmaterial (Lieferung der Gestaltung) – NICHT ins Repo.
# Enthaelt u. a. YU_CI.ai mit ~270 MB (GitHub lehnt >100 MB ab) sowie
# lizenzpflichtige Schriften. Was die Website braucht, liegt aufbereitet
# in public/ (Logos als SVG, Schriften als WOFF2).
ci/

# Lizenzpflichtige Schriftdateien – bewusst NICHT im Repo.
# "Helvetica Rounded LT Std" und "Blob Regular" sind kommerziell. Einchecken
# wuerde sie ueber GitHub verteilen. Die Quelldateien liegen in ci/Fonts/;
# ausgeliefert werden nur die daraus erzeugten WOFF2 in public/fonts/.
*.otf
*.ttf

# Betriebssystem / Editor / Tools
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.claude/

# Rohmaterial (Originalfotos bis 9 MB, Word-Dateien) – liegt bewusst
# AUSSERHALB von public/: Alles in public/ landet beim Bauen in dist/ und
# würde mit hochgeladen. Die Seite nutzt nur die optimierten Fassungen in
# public/images/personen/ und public/images/programm/.
material/
public/**/*.docx
